PORT=3000
NODE_ENV=production

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=PASTE_SERVER_SIDE_TOKEN
PHONE_NUMBER_ID=PASTE_PHONE_NUMBER_ID
WABA_ID=PASTE_WABA_ID
GRAPH_VERSION=v23.0

# Meta webhook verification
META_VERIFY_TOKEN=MAKE_A_LONG_RANDOM_VALUE

# Optional: protect the dashboard with one shared password.
# Leave blank only for local development.
DASHBOARD_PASSWORD=CHANGE_ME

# Supabase (replaces the old SQLite file storage)
# Get these from your Supabase project: Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the service_role secret key (NOT the anon/publishable key) so the
# backend can read/write these tables, which have RLS enabled with no
# public policies.
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY

# n8n integration (chatbot + human handoff)
# The n8n webhook (Webhook node, "Production URL") that receives inbound
# WhatsApp messages while a conversation's bot_enabled flag is true.
N8N_WEBHOOK_URL=https://YOUR-N8N-HOST/webhook/whatsapp-in
# A long random string that n8n must send back in the "x-n8n-secret" header
# when it calls /api/n8n/send or /api/n8n/handoff. Keeps the Meta access
# token and dashboard password out of n8n entirely.
N8N_SHARED_SECRET=MAKE_ANOTHER_LONG_RANDOM_VALUE
