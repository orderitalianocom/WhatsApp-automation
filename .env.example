PORT=3000
NODE_ENV=production

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=PASTE_SERVER_SIDE_TOKEN
PHONE_NUMBER_ID=PASTE_PHONE_NUMBER_ID
WABA_ID=PASTE_WABA_ID
GRAPH_VERSION=v23.0

# Meta webhook verification
META_VERIFY_TOKEN=MAKE_A_LONG_RANDOM_VALUE

# Optional: protect the dashboard with one shared password.
# Leave blank only for local development.
DASHBOARD_PASSWORD=CHANGE_ME

# Supabase (replaces the old SQLite file storage)
# Get these from your Supabase project: Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the service_role secret key (NOT the anon/publishable key) so the
# backend can read/write these tables, which have RLS enabled with no
# public policies.
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY
